FROM ubuntu:latest

# == 1. Install build dependencies =========================================
RUN apt-get update && apt-get install -y \
    build-essential \
    bison \
    flex \
    libgmp-dev \
    libmpc-dev \
    libmpfr-dev \
    texinfo \
    wget \
    grub-common \
    grub-pc-bin \
    xorriso \
    && rm -rf /var/lib/apt/lists/*

# == 2. Set env vars ======================================================
ENV PREFIX=/opt/cross
ENV TARGET=i686-elf
ENV PATH="$PREFIX/bin:$PATH"

# Versions to build
ENV BINUTILS_VERSION=2.42
ENV GCC_VERSION=14.2.0

# == 3. Download source tarballs =========================================
WORKDIR /tmp/src
RUN wget https://ftp.gnu.org/gnu/binutils/binutils-${BINUTILS_VERSION}.tar.gz \
    && wget https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.gz \
    && tar -xf binutils-${BINUTILS_VERSION}.tar.gz \
    && tar -xf gcc-${GCC_VERSION}.tar.gz

# == 4. Build & install binutils =========================================
RUN mkdir /tmp/src/build-binutils && cd /tmp/src/build-binutils \
    && ../binutils-${BINUTILS_VERSION}/configure \
        --target=${TARGET} \
        --prefix="${PREFIX}" \
        --with-sysroot \
        --disable-nls \
        --disable-werror \
    && make -j$(nproc) \
    && make install

# == 5. Build & install gcc =========================================
RUN mkdir /tmp/src/build-gcc && cd /tmp/src/build-gcc \
    && ../gcc-${GCC_VERSION}/configure \
        --target=${TARGET} \
        --prefix="${PREFIX}" \
        --disable-nls \
        --enable-languages=c \
        --without-headers \
    && make -j$(nproc) all-gcc \
    && make -j$(nproc) all-target-libgcc \
    && make install-gcc \
    && make install-target-libgcc

RUN rm -rf /tmp/src

# Verify the cross-compiler works
RUN ${TARGET}-gcc --version

WORKDIR /workspace